# Copie para .env e ajuste os valores
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção com HTTPS (RNF10): defina DJANGO_DEBUG=False e USE_HTTPS=True
USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=

DB_NAME=croche
DB_USER=croche
DB_PASSWORD=croche_senha
DB_ROOT_PASSWORD=root_senha
DB_HOST=db
DB_PORT=3306

# Administrador criado automaticamente na primeira execução
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Porta da loja no computador (padrão 8000)
WEB_PORT=8000
